# ================================================
# Configuración del Cliente WiFi - Rx
# ================================================

# Interfaz WiFi a usar para conectarse
WIFI_INTERFACE=wlp3s0

# SSID del hotspot a conectarse
HOTSPOT_SSID=evalvid_lab

# Contraseña del hotspot
HOTSPOT_PASSWORD=12345678

# ================================================
# Configuración del servidor Chrony (opcional)
# ================================================

# IP del servidor Tx (detectada automáticamente si está vacía)
# Dejar vacío para autodetección
TX_SERVER_IP=

# Puerto del servidor Chrony (por defecto 123)
CHRONY_PORT=323

# ================================================
# Opciones avanzadas de sincronización
# ================================================

# Tiempo máximo de espera para conectar al hotspot (segundos)
CONNECT_TIMEOUT=30

# Tiempo máximo de espera para obtener IP (segundos)
DHCP_TIMEOUT=15

# Intentos de ping antes de fallar
PING_ATTEMPTS=3

# Tiempo de espera entre intentos de conexión (segundos)
RETRY_WAIT=2

# Tiempo máximo para sincronizar Chrony (segundos)
CHRONY_START_TIMEOUT=10

# ================================================
# Configuración de Captura de Video (mp4trace)
# ================================================

# Puerto UDP donde mp4trace recibe los paquetes
VIDEO_UDP_PORT=5000

# Interfaz de red a capturar (donde recibe el video)
CAPTURE_INTERFACE=wlp3s0

# Directorio donde se guardan los PCAP
PCAP_DIR=PCAP

# Rutas a herramientas evalvid
EVALVID_PATH=~/evalvid
ETMP4_PATH=~/evalvid/etmp4


# IP del servidor Tx (gateway del hotspot)
TX_SERVER_IP=10.42.0.1

